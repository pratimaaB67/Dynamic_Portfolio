<%- include("Navbar.ejs") %>

<div class="container mt-4">

    <!-- Heading -->
    <div class="row mb-4">
        <div class="col-md-12 text-center bg-white p-3 rounded shadow-sm">
            <h2 class="fw-bolder text-primary display-6 border-bottom pb-2">
                📁 Project Section
            </h2>
        </div>
    </div>

    <!-- Form Card -->
     <form action="/admin/save_project" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-12 bg-white p-4 rounded shadow-sm">

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Project Title</label>
                    <input type="text" name="title" class="form-control" placeholder="Enter Project Title">
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Upload Image</label>
                    <input type="file" name="image" class="form-control">
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Technology</label>
                    <input type="text" name="technology" class="form-control" placeholder="e.g. HTML, Node.js">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">GitHub Link</label>
                    <input type="text" name="link" class="form-control" placeholder="Enter GitHub URL">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Live Link</label>
                    <input type="text" name="live_link" class="form-control" placeholder="Enter Live URL">
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold">Project Details</label>
                    <textarea name="details" class="form-control" rows="3" placeholder="Enter project details"></textarea>
                </div>

                <!-- Button -->
                <div class="col-md-12 text-center mt-3">
                    <button class="btn btn-primary px-4 fw-bold">
                        ➕ Add Project
                    </button>
                </div>

            </div>

        </div>
    </div>

    </form>
</div>


<div class="container mt-5">
    <div class="row text-center mb-2">
        <div class="col-md-12">
            <h1 class="bg-white p-2 rounded text-center fw-bold mt-1 shadow-sm">📁 Project's List</h1>
        </div>
    </div>
    <div class="row card-body shadow-lgb border-0">
        <div class="col-md-12 card-body p-3">
            <table class="table table-striped align-middle table-hover">
                 <thead class="table-primary ">
                <tr>
                    <th>Sr.No</th>
                    <th>Title</th>
                    <th>Technology</th>
                    <th>GitHub Link</th>
                    <th>Live Link</th>
                    <th>Image</th>
                    <th>Action</th>
                </tr>
                </thead>
                <% project.map(function(item,i){ %>

                    <tr>
                        <td><%= i+1 %></td>
                        <td><%= item.title %></td>
                        <td><%= item.technology %></td>
                        <td>
                            <a href="<%= item.link %>" target="_blank">Github Link</a>
                        </td>
                        <td>
                            <a href="<%= item.live_link %>" target="_blank">Live Link</a>
                        </td>
                        <td>
                            <img src="/<%= item.image%>" style="width: 70px;height: 70px;">
                        </td>
                        <td>
                            <a href="/admin/del_project/<%= item.id%>" class="btn-outline-danger btn"><i class="fa-solid fa-trash"></i></a>
                            <a href="/admin/edit_project/<%= item.id%>" class="btn-outline-primary btn"><i class="fa-solid fa-pen-to-square"></i></a>
                        </td>
                    </tr>

                <%})%>
            </table>
        </div>
    </div>
</div>
<%- include("Footer.ejs") %>