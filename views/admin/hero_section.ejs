<%-include ("Navbar.ejs") %>
<form action="/admin/save_hero_section" enctype="multipart/form-data" method="post">
    
<div class="container">
    <div class="row bg-white p-3 rounded text-center">
        <div class="col-md-12">
            <h1 class="fw-bold">Hero Section</h1>
        </div>
    </div>
    <div class="row bg-white rounded mt-4 pb-3">
        <div class="col-md-4 mb-2 mt-4 fw-bold">
            Upload Profile Photo: <br>
            <input type="file" name="hero_img" class="form-control mt-2" accept="image/jpeg, image/png, image/jpg"><br>
        </div>
        <div class="col-md-4 mt-4 fw-bold">
            Enter Full Name: <br>
            <input type="text" name="fullname" class="form-control mt-2 " placeholder="Enter Full Name" value="<%=info[0].fullname %>">
        </div>
         <div class="col-md-4 mt-4 fw-bold">
            Enter Your Position: <br>
            <input type="text" name="position" class="form-control mt-2 " placeholder="Enter Position" value="<%=info[0].position %>">
        </div>
            <div class="col-md-12 fw-bold">
                Enter Details: <br>
                <textarea name="details" class="form-control mt-2" placeholder="Enter Details"> <%=info[0].details %></textarea>
            </div>
        <div class="col-md-12 text-center mt-4">
           <button class="btn btn-primary btn-large">Save</button>
        </div>
    </div>
</div>
</form>

<%-include ("Footer.ejs") %>