<%- include("Navbar.ejs") %>

<div class="container mt-4">

    <!-- Heading -->
    <div class="row">
        <div class="col-12">
            <div class="bg-white rounded shadow-lg p-3 mb-4 text-center">
                <h1 class="fw-bold mb-0">🎓 Education Details</h1>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="row">
        <div class="col-12">
            <div class="bg-white rounded shadow-lg p-4">
                
                <form action="/admin/save_education" method="post">
                    <div class="row g-3">

                        <!-- Row 1: Course + Start + End Year -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Course</label>
                            <input type="text" name="course" class="form-control" placeholder="B.Tech / BCS">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Start Year</label>
                            <input type="number" name="start_year" class="form-control" placeholder="2022">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">End Year</label>
                            <input type="number" name="end_year" class="form-control" placeholder="2026">
                        </div>

                        <!-- Row 2: Institute -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Institute Name</label>
                            <input type="text" name="institute" class="form-control" placeholder="Enter Institute Name">
                        </div>

                        <!-- Row 3: Marks -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">CGPA / Marks</label>
                            <input type="text" name="marks" class="form-control" placeholder="Enter CGPA / Marks">
                        </div>

                        <!-- Row 4: Coursework -->
                        <div class="col-12">
                            <label class="form-label fw-bold">Relevant Coursework</label>
                            <input type="text" name="coursework" class="form-control" placeholder="DSA, Web Dev, DBMS">
                        </div>

                        <!-- Button -->
                        <div class="col-12 text-center mt-3">
                            <button type="submit" class="btn btn-primary px-5">
                                Submit
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>

</div>

<div class="container mt-5">

    <!-- Heading -->
    <div class="text-center mb-3">
        <h2 class="fw-bold">📚 Education List</h2>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-primary text-center">
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Duration</th>
                            <th>Institute</th>
                            <th>Marks</th>
                            <th>Coursework</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% edu_list.forEach(function(item, i){ %>

                        <tr>
                            <td class="text-center"><%= i+1 %></td>

                            <td class="fw-semibold">
                                <%= item.course %>
                            </td>

                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    <%= item.start_year %> - <%= item.end_year %>
                                </span>
                            </td>

                            <td><%= item.institute %></td>

                            <td class="text-center">
                                <span class="badge bg-success">
                                    <%= item.marks %>
                                </span>
                            </td>

                            <td style="max-width: 200px;">
                                <small class="text-muted">
                                    <%= item.coursework %>
                                </small>
                            </td>

                            <td class="text-center">
                                <a href="/admin/edit_edu/<%= item.id %>" class="btn btn-sm btn-outline-primary me-1">
                                   <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a href="/admin/delete_edu/<%= item.id %>" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>

                        <% }) %>
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
<%- include("Footer.ejs") %>