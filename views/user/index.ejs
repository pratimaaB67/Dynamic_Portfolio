        </section>
  </main>

  <footer>
    <p>© 2026 Pratima Bankar — Designed with 💜, Dark Mode & simplicity. All rights reserved.</p>
  </footer>

  <script>
    // ========== DARK MODE TOGGLE (पूर्णपणे कार्यशील) ==========
    const toggleBtn = document.getElementById('darkModeToggle');
    const toggleIcon = toggleBtn.querySelector('i');
    const toggleText = document.getElementById('toggleText');

    // Check saved preference or system preference
    function setDarkMode(isDark) {
      if (isDark) {
        document.body.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        toggleIcon.className = 'fas fa-sun';
        toggleText.innerText = 'Light';
      } else {
        document.body.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        toggleIcon.className = 'fas fa-moon';
        toggleText.innerText = 'Dark';
      }
    }

    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      setDarkMode(true);
    } else if (savedTheme === 'light') {
      setDarkMode(false);
    } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      setDarkMode(true);
    } else {
      setDarkMode(false);
    }

    toggleBtn.addEventListener('click', () => {
      const isDark = document.body.classList.contains('dark');
      setDarkMode(!isDark);
    });

    // ========== FORM FEEDBACK (No backend) ==========
    const contactForm = document.getElementById('contactForm');
    const feedbackPara = document.getElementById('formFeedback');

    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = contactForm.querySelector('input[name="username"]').value.trim();
      const email = contactForm.querySelector('input[name="email"]').value.trim();
      const msg = contactForm.querySelector('textarea[name="msg"]').value.trim();

      if (!name || !email || !msg) {
        feedbackPara.innerHTML = '⚠️ Please fill all fields!';
        feedbackPara.style.color = '#ff6b6b';
        setTimeout(() => feedbackPara.innerHTML = '', 2500);
        return;
      }
      if (!email.includes('@')) {
        feedbackPara.innerHTML = '📧 Please enter a valid email address.';
        feedbackPara.style.color = '#ff6b6b';
        setTimeout(() => feedbackPara.innerHTML = '', 2500);
        return;
      }
      feedbackPara.innerHTML = `✨ Thanks ${name}! Your message has been received. I'll get back to you soon.`;
      feedbackPara.style.color = 'var(--accent)';
      contactForm.reset();
      setTimeout(() => feedbackPara.innerHTML = '', 3000);
    });

    // ========== Active section highlight on scroll ==========
    const sections = document.querySelectorAll('section');
    const navLinks = document.querySelectorAll('.nav-links a');
    
    window.addEventListener('scroll', () => {
      let current = '';
      const scrollPos = window.scrollY + 150;
      sections.forEach(section => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.clientHeight;
        if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
          current = section.getAttribute('id');
        }
      });
      navLinks.forEach(link => {
        link.style.borderBottom = 'none';
        link.style.paddingBottom = '0px';
        if (link.getAttribute('href') === `#${current}`) {
          link.style.borderBottom = `2px solid var(--accent)`;
          link.style.paddingBottom = '4px';
        }
      });
    });

    // small fade on load
    document.body.classList.add('fade-up');
  </script>
</body>

</html>
